# Supabase project configuration
# Create a project at https://supabase.com and copy these values from
# Project Settings > API. Never commit real values to source control.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key, used exclusively in server components / route handlers.
# Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "true" to force the app into seeded demo mode even if Supabase
# credentials above are present. The app automatically falls back to demo
# mode when Supabase credentials are missing.
NEXT_PUBLIC_FORCE_DEMO_MODE=false

# Public app URL, used for auth redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JusticeIQ <-> JusticeChamp integration (see docs/INTEGRATION_SPEC.md)
# Shared secret used to verify inbound requests from JusticeIQ (case updates,
# important dates). Must match JUSTICECHAMP_WEBHOOK_SECRET in the JusticeIQ
# app for the demo bridge to work. Falls back to a demo default if unset.
JUSTICECHAMP_WEBHOOK_SECRET=replace-with-a-long-random-value
